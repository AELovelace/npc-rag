# Copy to .env and edit. Real environment variables override this file.

# -- Model servers (both launched by Sakura) -------------------------------------
# Main model that writes Pip's replies.
LLM_URL=http://127.0.0.1:9090
LLM_MODEL=local
# Small model for GAME or CHAT. Strong wiki evidence returns early and cancels pending classifier work.
CLASSIFIER_URL=http://127.0.0.1:9091
CLASSIFIER_MODEL=local
# Choose llamacpp (existing HTTP service) or decider (native model inside this RAG process).
CLASSIFIER_BACKEND=llamacpp
# Decider ignores CLASSIFIER_URL/MODEL; install requirements-decider.txt before enabling it.
# Managed alias: verify/download our qualified model and tokenizer from https://lidoll.dev/gguf/.
# Configs come from npc_rag/decider_config in this checkout: git pull + restart applies tuning.
# Cached in data/models/decider0-1; later launches work offline. Explicit HF IDs/local paths still work.
DECIDER_MODEL=lidoll/decider0-1
DECIDER_GGUF_FILE=decider0-1.gguf
DECIDER_THREADS=4
DECIDER_GPU_LAYERS=0
DECIDER_CONTEXT=4096
# One model per RAG process. First Decider startup downloads GGUF + tokenizer/config; no new port.
# Total classifier-model wait in seconds, including its slot queue. Retrieval has its own runtime.
CLASSIFIER_TIMEOUT=10
# Cache model labels for repeated messages; zero size or TTL disables caching and shared in-flight calls.
CLASSIFIER_CACHE_SIZE=1024
CLASSIFIER_CACHE_TTL=300
# Advertised model IDs are checked every 30 seconds. Restart RAG after swaps using the same model alias.
# Bearer token, only if llama-server was started with --api-key.
LLM_API_KEY=

# -- Optional OpenAI overflow on this same 9092 service ----------------------------
# A nonempty key enables overflow; local models remain preferred. Requires NPC_API_KEY.
# RAG runs here first; only the prepared generation prompt is sent to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_LOCAL_CAPACITY=4
OPENAI_CONCURRENCY=4
OPENAI_TIMEOUT=12
# Local capacity counts all generations through this process, including memory jobs.
# It is capped by LLM_CONCURRENCY times the number of model copies in LLM_URL.
# Background memory jobs and classifiers stay local. Empty OPENAI_API_KEY disables overflow.

# -- This service -----------------------------------------------------------------
# The game server calls /v1/npc/chat here.
NPC_HOST=0.0.0.0
NPC_PORT=9092
# Shared secret. Callers send "Authorization: Bearer <key>" or "X-Api-Key: <key>".
# Set this before opening the port to anything but localhost.
NPC_API_KEY=

# -- Wiki index -------------------------------------------------------------------
# Public wiki URL, or a local copy (the lidollquest repo root or its web/wiki folder).
WIKI_SOURCE=https://lidoll.dev/wiki/
WIKI_PUBLIC_URL=https://lidoll.dev/wiki/
EMBED_MODEL=BAAI/bge-small-en-v1.5
# onnxruntime threads for embeddings; 0 = automatic. Lower it if llama.cpp shares these CPU cores.
EMBED_THREADS=0
CHUNK_WORDS=180
# Sections scoring below this are never shown to the model; a game question with none gets "I'm not sure".
MIN_RELEVANCE=0.60
# A best wiki score at or above this makes a message a game question without waiting for the classifier.
RAG_GAME_EVIDENCE=0.66
# Keyword rule: a score of RAG_KEYWORD_DENSE or more also counts when one wiki section holds at least
# RAG_KEYWORD_COVERAGE of the message's meaningful words (catches short keyword questions). Above 1 disables it.
RAG_KEYWORD_COVERAGE=0.5
RAG_KEYWORD_DENSE=0.62

# -- Guard ------------------------------------------------------------------------
# Sections scoring more than this below the best one are dropped (stops weak matches steering answers).
GUARD_KEEP_MARGIN=0.06
# Sections shorter than this many words (one-line chapter overviews) never count as notes.
GUARD_MIN_WORDS=15
# Extra attempts when a reply names things no source mentions; after that Pip says she isn't sure.
GUARD_RETRIES=1
# Comma-separated names Pip may always use, e.g. hub or NPC names missing from the wiki.
GUARD_ALLOWED_TERMS=

# -- The NPC ----------------------------------------------------------------------
NPC_NAME=Pip
PERSONA_FILE=data/persona.md
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.6
MAX_REPLY_CHARS=600
LLM_TIMEOUT=45
LLM_CONCURRENCY=2
RAG_TOP_K=4
MAX_MESSAGE_CHARS=500
SESSION_TURNS=6
SESSION_TTL=1800

# Optional separate GM wiki assistant. See GM_HELP.md; requires its own key.
GM_HOST=127.0.0.1
GM_PORT=9093
GM_API_KEY=
GM_WIKI_SOURCE=data/gm-wiki
GM_INDEX_DIR=data/gm-index
GM_LLM_URL=http://127.0.0.1:9090
GM_MAX_TOKENS=1100
GM_LLM_TIMEOUT=60
GM_MIN_RELEVANCE=0.5

# Companions (/v1/companion/chat, LangGraph pipeline). The game server sends every memory; these only tune retrieval.
# COMPANION_LORE_K=2
# COMPANION_LORE_MIN=0.5
# COMPANION_MEMORY_K=4
# COMPANION_MEMORY_MIN=0.45
# COMPANION_GOSSIP_MIN=0.45
# COMPANION_MAX_REPLY_CHARS=240
# COMPANION_EMBED_CACHE=5000
# COMPANION_MAX_TOKENS=100   # Companion replies are cut to 240 characters anyway; stop generating sooner.
# COMPANION_NOTE_K=2         # Wiki notes a companion game answer may use (Pip keeps RAG_TOP_K).
# COMPANION_NOTE_WORDS=120   # Each companion note is cut to this many words (shorter prompts read faster).
# LLM_URL may list several model copies, e.g. one per graphics card: LLM_URL=http://127.0.0.1:9090,http://127.0.0.1:9091
