# Copy to .env and edit. Real environment variables override this file.

# ── Where things live ─────────────────────────────────────────────────────────
# llama.cpp server that writes the NPC's replies. If this service runs ON the AI server,
# http://127.0.0.1:9090 avoids a trip through the router (the public IP may not loop back).
LLM_URL=http://47.51.162.110:9090
# Bearer token, only if llama.cpp was started with --api-key.
LLM_API_KEY=

# Classifier + agent: the game server calls this one.
AGENT_HOST=0.0.0.0
AGENT_PORT=9091
# Wiki retrieval: only the agent needs it, so it stays on localhost.
RAG_HOST=127.0.0.1
RAG_PORT=9092
RAG_URL=http://127.0.0.1:9092

# Shared secret. Callers send "Authorization: Bearer <key>" or "X-Api-Key: <key>".
# Set this before opening port 9091 to anything but localhost.
NPC_API_KEY=

# ── Wiki index ────────────────────────────────────────────────────────────────
# Public wiki URL, or a local copy (the lidollquest repo root or its web/wiki folder).
WIKI_SOURCE=https://lidoll.dev/wiki/
WIKI_PUBLIC_URL=https://lidoll.dev/wiki/
EMBED_MODEL=BAAI/bge-small-en-v1.5
# onnxruntime threads for embeddings; 0 = automatic. Lower it if llama.cpp shares these CPU cores.
EMBED_THREADS=0
CHUNK_WORDS=180
MIN_RELEVANCE=0.60

# ── Classifier ────────────────────────────────────────────────────────────────
CLASSIFIER_MARGIN=0.04
RAG_GAME_EVIDENCE=0.66
CLASSIFIER_LLM_TIEBREAK=1

# ── The NPC ───────────────────────────────────────────────────────────────────
NPC_NAME=Pip
PERSONA_FILE=data/persona.md
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.6
MAX_REPLY_CHARS=600
LLM_TIMEOUT=45
LLM_CONCURRENCY=2
RAG_TOP_K=4
MAX_MESSAGE_CHARS=500
SESSION_TURNS=6
SESSION_TTL=1800
