# Copy to .env and edit. Real environment variables override this file.

# -- Student fleet (optional): npc-rag runs the lidoll-fm copies itself ---------------
# STUDENT_FLEET=on downloads the pinned GGUF from lidoll.dev/gguf (npc_rag/student_release.json, sha256-checked), launches
# STUDENT_COPIES_PER_DEVICE llama-server copies per GPU and replaces LLM_URL / LLM_CONCURRENCY below with them.
# Stop Sakura's llama copies first. Two copies per card help because each llama-server feeds its GPU from one CPU thread.
STUDENT_FLEET=off
# Optional: empty = llama-server on PATH, else C:/Scripts/llama/*/ or the Sakura folder (Vulkan build preferred).
LLAMA_SERVER=
# Empty = the release list's default (lidoll-fm-0.4); lidoll-fm-0.3 rolls back.
STUDENT_MODEL=
# auto, or a list such as Vulkan0,Vulkan1 / CUDA0,CUDA1.
STUDENT_DEVICES=auto
STUDENT_COPIES_PER_DEVICE=2
# -np per copy; also the reply concurrency per copy.
STUDENT_SLOTS=4
STUDENT_CTX_PER_SLOT=8192
# Copies take the first free ports from here; NPC_PORT, ADMIN_PORT, STUDENT_RESERVED_PORTS and busy ports are skipped.
STUDENT_BASE_PORT=9100
# Copies listen on this machine only; npc-rag is the only thing that talks to them.
STUDENT_HOST=127.0.0.1
# Never used by a copy: 9090 (old Sakura copies, or Cockpit if installed), 9091 the control page.
STUDENT_RESERVED_PORTS=9090,9091
# The RAM prompt cache restores each character's long prompt start into any slot (4 GB per copy).
STUDENT_ARGS=--flash-attn on --cache-ram 4096

# -- Model servers (both launched by Sakura) -------------------------------------
# Main model that writes Pip's replies. Ignored when STUDENT_FLEET=on.
LLM_URL=http://127.0.0.1:9090
LLM_MODEL=local
# Small model for GAME or CHAT. Strong wiki evidence returns early and cancels pending classifier work.
CLASSIFIER_URL=http://127.0.0.1:9091
CLASSIFIER_MODEL=local
# Choose llamacpp (existing HTTP service) or decider (native CPU worker or GPU process pool).
# Student-fleet nodes use decider: 9091 is the control page there, not a classifier.
CLASSIFIER_BACKEND=llamacpp
# Decider ignores CLASSIFIER_URL/MODEL; install requirements-decider.txt before enabling it.
# Managed alias: verify/download our qualified model and tokenizer from https://lidoll.dev/gguf/.
# Configs come from npc_rag/multitask_config in this checkout: git pull + restart applies tuning.
# Cached in data/models/decider-multitask-v3; later launches work offline. Legacy models remain supported.
DECIDER_MODEL=lidoll/decider-multitask-v3
DECIDER_GGUF_FILE=decider-multitask-v3.gguf
DECIDER_THREADS=4
DECIDER_GPU_LAYERS=0
DECIDER_GPU_DEVICES=auto
# auto|on|off. off: llama-cpp-python 0.3.36 HIP builds abort in flash attention on RX 6800-class cards (gfx1030).
DECIDER_FLASH_ATTN=auto
# With GPU layers enabled, auto creates one worker per detected dedicated GPU.
# Optional override: CUDA0,CUDA1 or Vulkan0,Vulkan1 (names from python -m npc_rag devices).
# CPU mode (GPU_LAYERS=0) keeps one worker and ignores GPU device selection.
DECIDER_CONTEXT=4096
# Optional JOIN/QUIET endpoint sharing the combined model's routing workers and queue.
# Enable after hosting decider-multitask-v3.gguf AND decider-multitask-v3-support.zip.
# Requires CLASSIFIER_BACKEND=decider. Both tasks share DECIDER_GPU_LAYERS/DEVICES/THREADS.
PARTICIPATION_ENABLED=false
PARTICIPATION_MODEL=shared
PARTICIPATION_TIMEOUT=10
# One model per worker. First startup downloads GGUF + tokenizer/config once; no new port.
# Total classifier-model wait in seconds, including its slot queue. Retrieval has its own runtime.
CLASSIFIER_TIMEOUT=10
# Cache model labels for repeated messages; zero size or TTL disables caching and shared in-flight calls.
CLASSIFIER_CACHE_SIZE=1024
CLASSIFIER_CACHE_TTL=300
# Advertised model IDs are checked every 30 seconds. Restart RAG after swaps using the same model alias.
# Bearer token, only if llama-server was started with --api-key.
LLM_API_KEY=

# -- Optional OpenAI overflow on this same 9092 service ----------------------------
# A nonempty key enables overflow; local models remain preferred. Requires NPC_API_KEY.
# RAG runs here first; only the prepared generation prompt is sent to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_LOCAL_CAPACITY=4
OPENAI_CONCURRENCY=4
OPENAI_TIMEOUT=12
# Local capacity counts all generations through this process, including memory jobs.
# It is capped by LLM_CONCURRENCY times the number of model copies in LLM_URL.
# Background memory jobs and classifiers stay local. Empty OPENAI_API_KEY disables overflow.

# -- Control page (python -m npc_rag admin) -----------------------------------------
# Health, .env settings and restart for this node. Node layout: 9090 kept free, 9091 this page, 9092 the API.
# The page refuses to start until ADMIN_PASSWORD has 8+ characters. It is plain HTTP: keep 9091 on the LAN.
ADMIN_HOST=0.0.0.0
ADMIN_PORT=9091
ADMIN_PASSWORD=
# systemd unit the page shows, tails and restarts (linux/npc-rag.service).
ADMIN_SERVICE=npc-rag.service
# Empty = systemctl restart on Linux. Windows needs a command here, e.g. a scheduled task: schtasks /Run /TN npc-rag
ADMIN_RESTART_CMD=

# -- This service -----------------------------------------------------------------
# The game server calls /v1/npc/chat here.
NPC_HOST=0.0.0.0
NPC_PORT=9092
# Shared secret. Callers send "Authorization: Bearer <key>" or "X-Api-Key: <key>".
# Set this before opening the port to anything but localhost.
NPC_API_KEY=

# -- Wiki index -------------------------------------------------------------------
# Public wiki URL, or a local copy (the lidollquest repo root or its web/wiki folder).
WIKI_SOURCE=https://lidoll.dev/wiki/
WIKI_PUBLIC_URL=https://lidoll.dev/wiki/
EMBED_MODEL=BAAI/bge-small-en-v1.5
# onnxruntime threads for embeddings; 0 = automatic. Lower it if llama.cpp shares these CPU cores.
EMBED_THREADS=0
CHUNK_WORDS=180
# Sections scoring below this are never shown to the model; a game question with none gets "I'm not sure".
MIN_RELEVANCE=0.60
# A best wiki score at or above this makes a message a game question without waiting for the classifier.
RAG_GAME_EVIDENCE=0.66
# Keyword rule: a score of RAG_KEYWORD_DENSE or more also counts when one wiki section holds at least
# RAG_KEYWORD_COVERAGE of the message's meaningful words (catches short keyword questions). Above 1 disables it.
RAG_KEYWORD_COVERAGE=0.5
RAG_KEYWORD_DENSE=0.62

# -- Guard ------------------------------------------------------------------------
# Sections scoring more than this below the best one are dropped (stops weak matches steering answers).
GUARD_KEEP_MARGIN=0.06
# Sections shorter than this many words (one-line chapter overviews) never count as notes.
GUARD_MIN_WORDS=15
# Extra attempts when a reply names things no source mentions; after that Pip says she isn't sure.
GUARD_RETRIES=1
# Comma-separated names Pip may always use, e.g. hub or NPC names missing from the wiki.
GUARD_ALLOWED_TERMS=

# -- The NPC ----------------------------------------------------------------------
NPC_NAME=Pip
PERSONA_FILE=data/persona.md
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.6
MAX_REPLY_CHARS=600
LLM_TIMEOUT=45
LLM_CONCURRENCY=2
RAG_TOP_K=4
MAX_MESSAGE_CHARS=500
SESSION_TURNS=6
SESSION_TTL=1800

# Optional separate GM wiki assistant. See GM_HELP.md; requires its own key.
GM_HOST=127.0.0.1
GM_PORT=9093
GM_API_KEY=
GM_WIKI_SOURCE=data/gm-wiki
GM_INDEX_DIR=data/gm-index
# With STUDENT_FLEET=on nothing serves 9090: point this at a student copy (http://127.0.0.1:9100) instead.
GM_LLM_URL=http://127.0.0.1:9090
GM_MAX_TOKENS=1100
GM_LLM_TIMEOUT=60
GM_MIN_RELEVANCE=0.5

# Companions (/v1/companion/chat, LangGraph pipeline). The game server sends every memory; these only tune retrieval.
# COMPANION_LORE_K=2
# COMPANION_LORE_MIN=0.5
# COMPANION_MEMORY_K=4
# COMPANION_MEMORY_MIN=0.45
# COMPANION_GOSSIP_MIN=0.45
# COMPANION_MAX_REPLY_CHARS=240
# COMPANION_EMBED_CACHE=5000
# COMPANION_MAX_TOKENS=100   # Companion replies are cut to 240 characters anyway; stop generating sooner.
# COMPANION_NOTE_K=2         # Wiki notes a companion game answer may use (Pip keeps RAG_TOP_K).
# COMPANION_NOTE_WORDS=120   # Each companion note is cut to this many words (shorter prompts read faster).
# LLM_URL may list several model copies, e.g. one per graphics card: LLM_URL=http://127.0.0.1:9090,http://127.0.0.1:9091
