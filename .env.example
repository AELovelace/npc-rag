# Copy to .env and edit. Real environment variables override this file.

# -- Model servers (both launched by Sakura) -------------------------------------
# Main model that writes Pip's replies.
LLM_URL=http://127.0.0.1:9090
LLM_MODEL=local
# Small model that answers GAME or CHAT for each message. If it is down, the wiki score decides.
CLASSIFIER_URL=http://127.0.0.1:9091
CLASSIFIER_MODEL=local
CLASSIFIER_TIMEOUT=10
# Bearer token, only if llama-server was started with --api-key.
LLM_API_KEY=

# -- This service -----------------------------------------------------------------
# The game server calls /v1/npc/chat here.
NPC_HOST=0.0.0.0
NPC_PORT=9092
# Shared secret. Callers send "Authorization: Bearer <key>" or "X-Api-Key: <key>".
# Set this before opening the port to anything but localhost.
NPC_API_KEY=

# -- Wiki index -------------------------------------------------------------------
# Public wiki URL, or a local copy (the lidollquest repo root or its web/wiki folder).
WIKI_SOURCE=https://lidoll.dev/wiki/
WIKI_PUBLIC_URL=https://lidoll.dev/wiki/
EMBED_MODEL=BAAI/bge-small-en-v1.5
# onnxruntime threads for embeddings; 0 = automatic. Lower it if llama.cpp shares these CPU cores.
EMBED_THREADS=0
CHUNK_WORDS=180
# Sections scoring below this are never shown to the model; a game question with none gets "I'm not sure".
MIN_RELEVANCE=0.60
# With the classifier down, a best wiki score at or above this makes a message a game question.
RAG_GAME_EVIDENCE=0.66

# -- Guard ------------------------------------------------------------------------
# Sections scoring more than this below the best one are dropped (stops weak matches steering answers).
GUARD_KEEP_MARGIN=0.06
# Sections shorter than this many words (one-line chapter overviews) never count as notes.
GUARD_MIN_WORDS=15
# Extra attempts when a reply names things no source mentions; after that Pip says she isn't sure.
GUARD_RETRIES=1
# Comma-separated names Pip may always use, e.g. hub or NPC names missing from the wiki.
GUARD_ALLOWED_TERMS=

# -- The NPC ----------------------------------------------------------------------
NPC_NAME=Pip
PERSONA_FILE=data/persona.md
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.6
MAX_REPLY_CHARS=600
LLM_TIMEOUT=45
LLM_CONCURRENCY=2
RAG_TOP_K=4
MAX_MESSAGE_CHARS=500
SESSION_TURNS=6
SESSION_TTL=1800
