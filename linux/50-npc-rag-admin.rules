// Narrow service permissions for the control page and its separate repository updater.
// Installed to /etc/polkit-1/rules.d/ by install-ubuntu.sh.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "npcrag") {
        var verb = action.lookup("verb");
        var unit = action.lookup("unit");
        if ((unit == "npc-rag.service" && (verb == "restart" || verb == "start" || verb == "stop")) ||
            (unit == "npc-rag-admin.service" && verb == "restart") ||
            (unit == "npc-rag-update.service" && verb == "start")) {
            return polkit.Result.YES;
        }
    }
});
