// Lets the npcrag user (the control page) start, stop and restart npc-rag.service, and nothing else.
// Installed to /etc/polkit-1/rules.d/ by install-ubuntu.sh.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "npc-rag.service" &&
        subject.user == "npcrag") {
        var verb = action.lookup("verb");
        if (verb == "restart" || verb == "start" || verb == "stop") {
            return polkit.Result.YES;
        }
    }
});
